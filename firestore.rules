rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "yosjbxjbs@gmail.com"
      );
    }

    // Leaderboard: Public read, writes only by backend/admin
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Video Rewards: Public read, writes only by admin
    match /videoRewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Questions: Secret answers protected; only admin or cloud backend can read/write raw question documents
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // Question Allocations: Never modifiable by regular client
    match /questionAllocations/{allocationId} {
      allow read, write: if isAdmin();
    }

    // Sessions: Only readable if owned by player auth or admin, writes restricted
    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Players: Can read own profile or admin
    match /players/{playerId} {
      allow read: if isSignedIn() && (request.auth.uid == playerId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == playerId || isAdmin());
    }
  }
}
